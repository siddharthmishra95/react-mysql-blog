# Copy to .env and fill in your local MySQL credentials.
# .env is gitignored — never commit real credentials.

# Server
PORT=3001

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=react_mysql_blog

# Auth — use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
